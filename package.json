  "name": "dsh-approve-for-me",
  "version": "0.1.0-dev.0",
  "packageManager": "pnpm@11.7.0",
  "private": true,
  "description": "Managed approval reviewer plugin for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "build:approval-fork": "patch/dsh-user-approval/scripts/build-fork.sh",
    "bootstrap:target-host": "node scripts/bootstrap-target-host.mjs",
    "bootstrap:target-host:refresh": "node scripts/bootstrap-target-host.mjs --refresh",
    "verify:managed-source": "node scripts/verify-managed-agent-source.mjs",
    "build:managed-artifact": "node scripts/build-managed-artifact.mjs",
    "bootstrap:dependencies": "npm run build:approval-fork && npm run build:managed-artifact && npm run bootstrap:target-host && pnpm install --frozen-lockfile",
    "package:smoke": "node scripts/package-smoke.mjs",
    "profile:artifact-smoke": "node scripts/profile-artifact-smoke.mjs",
    "verify:approval-fork": "node patch/dsh-user-approval/scripts/verify-fork.mjs .build/dsh-user-approval-afm-0.1.2-alpha.1.tgz patch/dsh-user-approval/upstream.json",
    "verify:target-host": "node patch/dsh-user-approval/scripts/verify-target-host.mjs ../deepseek-harness .build/dsh-user-approval-afm-0.1.2-alpha.1.tgz patch/dsh-user-approval/upstream.json",
    "verify:installed-target-host": "node patch/dsh-user-approval/scripts/verify-target-host.mjs ../deepseek-harness .build/dsh-user-approval-afm-0.1.2-alpha.1.tgz patch/dsh-user-approval/upstream.json node_modules/@deepseek-ai/dsh-user-approval && node scripts/verify-target-install.mjs",
    "prepack": "npm run build"
  },
